# code: language=yaml
#
# Initialize $state with spec defaults
#

{{- $xr := getCompositeResource . }}
{{- $spec := $xr.spec | default dict }}
{{- $metadata := $xr.metadata | default dict }}

# ==============================================================================
# Core defaults
# ==============================================================================
{{- $name := $metadata.name | default "observe" }}
{{- $clusterName := $spec.clusterName | default $name }}
{{- $namespace := $spec.namespace | default "monitoring" }}
{{- $managementPolicies := $spec.managementPolicies | default (list "*") }}

# Labels
{{- $defaultLabels := dict
  "hops.ops.com.ai/managed" "true"
  "hops.ops.com.ai/observe" $name
  (printf "hops.ops.com.ai/%s" (lower $xr.kind)) $name
}}
{{- $labels := merge $defaultLabels ($spec.labels | default dict) }}

# ==============================================================================
# Provider config refs
# ==============================================================================
{{- $helmProviderConfigRef := $spec.helmProviderConfigRef | default dict }}
{{- $helmProviderConfigRef = dict
  "name" ($helmProviderConfigRef.name | default $clusterName)
  "kind" ($helmProviderConfigRef.kind | default "ProviderConfig")
}}

{{- $kubernetesProviderConfigRef := $spec.kubernetesProviderConfigRef | default dict }}
{{- $kubernetesProviderConfigRef = dict
  "name" ($kubernetesProviderConfigRef.name | default $clusterName)
  "kind" ($kubernetesProviderConfigRef.kind | default "ProviderConfig")
}}

{{- $awsProviderConfigRef := $spec.awsProviderConfigRef | default dict }}
{{- $awsProviderConfigRef = dict
  "name" ($awsProviderConfigRef.name | default "default")
  "kind" ($awsProviderConfigRef.kind | default "ProviderConfig")
}}

# ==============================================================================
# AWS defaults
# ==============================================================================
{{- $aws := $spec.aws | default dict }}
{{- $awsRegion := $aws.region }}

# Default tags
{{- $defaultTags := dict
  "hops.ops.com.ai/managed" "true"
  "hops.ops.com.ai/observestack" $name
}}
{{- $awsTags := merge $defaultTags ($aws.tags | default dict) }}

# ==============================================================================
# NodePool configuration
# ==============================================================================
{{- $nodePoolSpec := $spec.nodePool | default dict }}
{{- $nodePoolEnabled := false }}
{{- if hasKey $nodePoolSpec "enabled" }}
  {{- $nodePoolEnabled = $nodePoolSpec.enabled }}
{{- end }}
{{- $nodePoolName := "hops-observe" }}
{{- $nodePoolNodeClassName := $nodePoolSpec.nodeClassName | default "hops-default" }}
{{- $nodePoolLimits := $nodePoolSpec.limits | default (dict "cpu" "40" "memory" "160Gi") }}
{{- $nodePoolRequirements := $nodePoolSpec.requirements | default (list
  (dict "key" "karpenter.sh/capacity-type" "operator" "In" "values" (list "spot"))
  (dict "key" "eks.amazonaws.com/instance-category" "operator" "In" "values" (list "c" "m" "r" "t"))
  (dict "key" "eks.amazonaws.com/instance-generation" "operator" "Gte" "values" (list "4"))
  (dict "key" "kubernetes.io/os" "operator" "In" "values" (list "linux"))
) }}
{{- $nodePoolDisruption := $nodePoolSpec.disruption | default (dict "consolidationPolicy" "WhenEmptyOrUnderutilized" "consolidateAfter" "30s" "budgets" (list (dict "nodes" "100%"))) }}

# NodePool scheduling — applied to non-daemonset Helm values when enabled
{{- $nodePoolTaintKey := "observe" }}
{{- $nodePoolTaintValue := "true" }}
{{- $nodePoolNodeSelector := dict }}
{{- $nodePoolTolerations := list }}
{{- if $nodePoolEnabled }}
  {{- $nodePoolNodeSelector = dict "workload-type" "observe" }}
  {{- $nodePoolTolerations = list (dict "key" $nodePoolTaintKey "value" $nodePoolTaintValue "effect" "NoSchedule") }}
{{- end }}

{{- $opencostServiceAccountName := "opencost" }}

# ==============================================================================
# Per-component configuration (resolved from spec)
# ==============================================================================
{{- $kubePrometheusStack := $spec.kubePrometheusStack | default dict }}
{{- $kubePrometheusStackReleaseName := $kubePrometheusStack.name | default "kube-prometheus-stack" }}
{{- $kubePrometheusStackFullname := "observe" }}
{{- $kubePrometheusStackGrafanaServiceName := "grafana" }}
{{- $loki := $spec.loki | default dict }}
{{- $tempo := $spec.tempo | default dict }}
{{- $k8sMonitoring := $spec.k8sMonitoring | default dict }}
{{- $grafanaOperator := $spec.grafanaOperator | default dict }}
{{- $vpa := $spec.vpa | default dict }}
{{- $goldilocks := $spec.goldilocks | default dict }}
{{- $metricsServer := $spec.metricsServer | default dict }}
{{- $metricsServerEnabled := $metricsServer.enabled | default false }}

# ==============================================================================
# Storage config
# ==============================================================================
{{- $storageClassDefaultsInput := $spec.storageClassDefaults | default dict }}
{{- $storageClassDefaultsCreate := true }}
{{- if hasKey $storageClassDefaultsInput "create" }}
  {{- $storageClassDefaultsCreate = $storageClassDefaultsInput.create }}
{{- end }}
{{- $storageClassDefaultsAllowVolumeExpansion := true }}
{{- if hasKey $storageClassDefaultsInput "allowVolumeExpansion" }}
  {{- $storageClassDefaultsAllowVolumeExpansion = $storageClassDefaultsInput.allowVolumeExpansion }}
{{- end }}
{{- $storageClassDefaults := dict
  "create" $storageClassDefaultsCreate
  "provisioner" ($storageClassDefaultsInput.provisioner | default "ebs.csi.eks.amazonaws.com")
  "parameters" ($storageClassDefaultsInput.parameters | default (dict
    "type" "gp3"
    "fsType" "ext4"
  ))
  "allowVolumeExpansion" $storageClassDefaultsAllowVolumeExpansion
  "reclaimPolicy" ($storageClassDefaultsInput.reclaimPolicy | default "Delete")
  "volumeBindingMode" ($storageClassDefaultsInput.volumeBindingMode | default "WaitForFirstConsumer")
}}

{{- $defaultRetentionDays := 30 }}

{{- $lokiStorage := $loki.storage | default dict }}
{{- $lokiStorageType := $lokiStorage.type | default "pvc" }}
{{- $lokiStorageS3 := $lokiStorage.s3 | default dict }}
{{- $lokiStorageClassInput := $lokiStorage.storageClass | default dict }}
{{- $lokiS3Enabled := eq $lokiStorageType "s3" }}
{{- $lokiS3BucketName := $lokiStorageS3.bucketName | default (printf "%s-loki-storage" $name) }}
{{- $lokiRetentionDays := $lokiStorage.retentionDays | default ($lokiStorageS3.retentionDays | default $defaultRetentionDays) }}
{{- $lokiPVCSize := $lokiStorage.size | default "10Gi" }}
{{- $lokiStorageClassCreate := $storageClassDefaults.create }}
{{- if hasKey $lokiStorageClassInput "create" }}
  {{- $lokiStorageClassCreate = $lokiStorageClassInput.create }}
{{- end }}
{{- $lokiStorageClassAllowVolumeExpansion := $storageClassDefaults.allowVolumeExpansion }}
{{- if hasKey $lokiStorageClassInput "allowVolumeExpansion" }}
  {{- $lokiStorageClassAllowVolumeExpansion = $lokiStorageClassInput.allowVolumeExpansion }}
{{- end }}
{{- $lokiStorageClass := dict
  "create" $lokiStorageClassCreate
  "name" ($lokiStorageClassInput.name | default "loki")
  "provisioner" ($lokiStorageClassInput.provisioner | default $storageClassDefaults.provisioner)
  "parameters" ($lokiStorageClassInput.parameters | default $storageClassDefaults.parameters)
  "allowVolumeExpansion" $lokiStorageClassAllowVolumeExpansion
  "reclaimPolicy" ($lokiStorageClassInput.reclaimPolicy | default $storageClassDefaults.reclaimPolicy)
  "volumeBindingMode" ($lokiStorageClassInput.volumeBindingMode | default $storageClassDefaults.volumeBindingMode)
}}

{{- $tempoStorage := $tempo.storage | default dict }}
{{- $tempoStorageType := $tempoStorage.type | default "pvc" }}
{{- $tempoStorageS3 := $tempoStorage.s3 | default dict }}
{{- $tempoStorageClassInput := $tempoStorage.storageClass | default dict }}
{{- $tempoS3Enabled := eq $tempoStorageType "s3" }}
{{- $tempoS3BucketName := $tempoStorageS3.bucketName | default (printf "%s-tempo-storage" $name) }}
{{- $tempoRetentionDays := $tempoStorage.retentionDays | default ($tempoStorageS3.retentionDays | default $defaultRetentionDays) }}
{{- $tempoPVCSize := $tempoStorage.size | default "10Gi" }}
{{- $tempoStorageClassCreate := $storageClassDefaults.create }}
{{- if hasKey $tempoStorageClassInput "create" }}
  {{- $tempoStorageClassCreate = $tempoStorageClassInput.create }}
{{- end }}
{{- $tempoStorageClassAllowVolumeExpansion := $storageClassDefaults.allowVolumeExpansion }}
{{- if hasKey $tempoStorageClassInput "allowVolumeExpansion" }}
  {{- $tempoStorageClassAllowVolumeExpansion = $tempoStorageClassInput.allowVolumeExpansion }}
{{- end }}
{{- $tempoStorageClass := dict
  "create" $tempoStorageClassCreate
  "name" ($tempoStorageClassInput.name | default "tempo")
  "provisioner" ($tempoStorageClassInput.provisioner | default $storageClassDefaults.provisioner)
  "parameters" ($tempoStorageClassInput.parameters | default $storageClassDefaults.parameters)
  "allowVolumeExpansion" $tempoStorageClassAllowVolumeExpansion
  "reclaimPolicy" ($tempoStorageClassInput.reclaimPolicy | default $storageClassDefaults.reclaimPolicy)
  "volumeBindingMode" ($tempoStorageClassInput.volumeBindingMode | default $storageClassDefaults.volumeBindingMode)
}}

{{- $prometheusStorage := $kubePrometheusStack.storage | default dict }}
{{- $prometheusPVCSize := $prometheusStorage.size | default "10Gi" }}
{{- $prometheusRetentionDays := $prometheusStorage.retentionDays | default $defaultRetentionDays }}
{{- $prometheusStorageClassInput := $prometheusStorage.storageClass | default dict }}
{{- $prometheusStorageClassCreate := $storageClassDefaults.create }}
{{- if hasKey $prometheusStorageClassInput "create" }}
  {{- $prometheusStorageClassCreate = $prometheusStorageClassInput.create }}
{{- end }}
{{- $prometheusStorageClassAllowVolumeExpansion := $storageClassDefaults.allowVolumeExpansion }}
{{- if hasKey $prometheusStorageClassInput "allowVolumeExpansion" }}
  {{- $prometheusStorageClassAllowVolumeExpansion = $prometheusStorageClassInput.allowVolumeExpansion }}
{{- end }}
{{- $prometheusStorageClass := dict
  "create" $prometheusStorageClassCreate
  "name" ($prometheusStorageClassInput.name | default "prometheus")
  "provisioner" ($prometheusStorageClassInput.provisioner | default $storageClassDefaults.provisioner)
  "parameters" ($prometheusStorageClassInput.parameters | default $storageClassDefaults.parameters)
  "allowVolumeExpansion" $prometheusStorageClassAllowVolumeExpansion
  "reclaimPolicy" ($prometheusStorageClassInput.reclaimPolicy | default $storageClassDefaults.reclaimPolicy)
  "volumeBindingMode" ($prometheusStorageClassInput.volumeBindingMode | default $storageClassDefaults.volumeBindingMode)
}}

# ==============================================================================
# HA configuration
# ==============================================================================
{{- $haSpec := $spec.ha | default dict }}
{{- $haEnabled := false }}
{{- if hasKey $haSpec "enabled" }}
  {{- $haEnabled = $haSpec.enabled }}
{{- end }}
{{- $haReplicas := $haSpec.replicas | default 2 }}
{{- $haPdbSpec := $haSpec.pdb | default dict }}
{{- $haPdbEnabled := true }}
{{- if hasKey $haPdbSpec "enabled" }}
  {{- $haPdbEnabled = $haPdbSpec.enabled }}
{{- end }}
{{- $haPdbMinAvailable := $haPdbSpec.minAvailable | default 1 }}
{{- $haComponentSpecs := $haSpec.components | default dict }}
{{- $haComponents := dict }}
{{- range $componentName := list "prometheus" "alertmanager" "grafana" "opencost" "loki" "tempo" "oauth2Proxy" "redis" }}
  {{- $compSpec := get $haComponentSpecs $componentName | default dict }}
  {{- $compEnabled := $haEnabled }}
  {{- if eq $componentName "grafana" }}
    {{- $compEnabled = false }}
  {{- end }}
  {{- if hasKey $compSpec "enabled" }}
    {{- $compEnabled = and $haEnabled $compSpec.enabled }}
  {{- end }}
  {{- $compReplicas := $compSpec.replicas | default $haReplicas }}
  {{- if and (eq $componentName "loki") (not $lokiS3Enabled) }}
    {{- $compReplicas = 1 }}
  {{- end }}
  {{- if and (eq $componentName "tempo") (not $tempoS3Enabled) }}
    {{- $compReplicas = 1 }}
  {{- end }}
  {{- if eq $componentName "redis" }}
    {{- $compReplicas = 1 }}
  {{- end }}
  {{- $_ := set $haComponents $componentName (dict "enabled" $compEnabled "replicas" $compReplicas) }}
{{- end }}

# ==============================================================================
# Spot feed configuration
# ==============================================================================
{{- $spotFeed := $spec.spotFeed | default dict }}
{{- $spotFeedEnabled := $spotFeed.enabled | default false }}

# ==============================================================================
# Cloud cost configuration (CUR/Athena)
# ==============================================================================
{{- $cloudCosts := $spec.cloudCosts | default dict }}
{{- $cloudCostsConfigEnabled := $cloudCosts.enabled | default false }}
{{- $cloudCostsCostReportRef := $cloudCosts.costReportRef | default dict }}
{{- $cloudCostsCostReportRefEnabled := $cloudCostsCostReportRef.enabled | default false }}
{{- $cloudCostsEnabled := or $cloudCostsConfigEnabled $cloudCostsCostReportRefEnabled }}
{{- $cloudCostsSecretName := "opencost-cloud-integration" }}
{{- $cloudCostsBucketName := $cloudCosts.bucketName | default "" }}
{{- $cloudCostsRegion := $cloudCosts.region | default $awsRegion }}
{{- $cloudCostsAccountId := $cloudCosts.accountId | default "" }}
{{- $cloudCostsDatabaseName := $cloudCosts.databaseName | default "" }}
{{- $cloudCostsTableName := $cloudCosts.tableName | default "" }}
{{- $cloudCostsWorkgroupName := $cloudCosts.workgroupName | default "" }}
{{- $cloudCostsCostReportRefName := $cloudCostsCostReportRef.name | default "" }}
{{- $cloudCostsCostReportRefNameUnderscored := $cloudCostsCostReportRefName | replace "-" "_" }}
{{- if $cloudCostsCostReportRefEnabled }}
  {{- $cloudCostsBucketName = $cloudCostsCostReportRef.bucketName | default (printf "%s-cur" $cloudCostsCostReportRefName) }}
  {{- $cloudCostsRegion = $cloudCostsCostReportRef.region | default $awsRegion }}
  {{- $cloudCostsAccountId = $cloudCostsCostReportRef.accountId | default "" }}
  {{- $cloudCostsDatabaseName = $cloudCostsCostReportRef.databaseName | default (printf "%s_cur" $cloudCostsCostReportRefNameUnderscored) }}
  {{- $cloudCostsTableName = $cloudCostsCostReportRef.reportName | default (printf "%s_cur" $cloudCostsCostReportRefNameUnderscored) }}
  {{- $cloudCostsWorkgroupName = $cloudCostsCostReportRef.workgroupName | default (printf "%s-cur-workgroup" $cloudCostsCostReportRefName) }}
{{- end }}

# ==============================================================================
# Auth integration (Zitadel — composed via provider-upjet-zitadel)
# ==============================================================================
{{- $auth := $spec.auth | default dict }}
{{- $authStackRef := $auth.authStackRef | default dict }}
{{- $authIssuerURL := $auth.issuerURL | default "" }}
{{- $authAwsSmPath := $auth.awsSecretsManagerPath | default "" }}
{{- $authAccessTokenProperty := $auth.accessTokenProperty | default "access_token" }}
{{- $authProjectId := $auth.zitadelProjectId | default "" }}

{{- /* Derive zitadelDomain host from issuerURL when not explicitly set:
   trim scheme, then trim any path. */}}
{{- $authZitadelDomain := $auth.zitadelDomain | default "" }}
{{- if and (eq $authZitadelDomain "") (ne $authIssuerURL "") }}
  {{- $h := $authIssuerURL }}
  {{- $h = $h | trimPrefix "https://" | trimPrefix "http://" }}
  {{- $authZitadelDomain = (splitn "/" 2 $h)._0 }}
{{- end }}

# ==============================================================================
# Exposure (public exposure via oauth2-proxy + ext_authz)
# ==============================================================================
{{- $exposure := $spec.exposure | default dict }}
{{- $exposureEnabled := false }}
{{- if hasKey $exposure "enabled" }}
  {{- $exposureEnabled = $exposure.enabled }}
{{- end }}
{{- $exposureDomain := $exposure.domain | default "" }}

{{- /* Validate when enabled. */}}
{{- if $exposureEnabled }}
  {{- if eq $exposureDomain "" }}
    {{- fail "spec.exposure.domain is required when spec.exposure.enabled is true" }}
  {{- end }}
  {{- if eq $authIssuerURL "" }}
    {{- fail "spec.auth.issuerURL is required when spec.exposure.enabled is true" }}
  {{- end }}
  {{- if eq $authAwsSmPath "" }}
    {{- fail "spec.auth.awsSecretsManagerPath is required when spec.exposure.enabled is true" }}
  {{- end }}
  {{- if eq $authProjectId "" }}
    {{- fail "spec.auth.zitadelProjectId is required when spec.exposure.enabled is true" }}
  {{- end }}
{{- end }}

{{- $exposureGatewayRef := $exposure.gatewayRef | default dict }}
{{- $exposureGatewayRefSectionNames := $exposureGatewayRef.sectionNames | default (list "http" "https-apex") }}
{{- $exposureGatewayRef = dict
  "name" ($exposureGatewayRef.name | default "platform")
  "namespace" ($exposureGatewayRef.namespace | default "istio-ingress")
  "sectionNames" $exposureGatewayRefSectionNames
}}

{{- $exposureExtProviderName := $exposure.extensionProviderName | default (printf "%s-oauth2-proxy" $namespace) }}

{{- $exposureCert := $exposure.certificate | default dict }}
{{- $exposureCertEnabled := false }}
{{- if hasKey $exposureCert "enabled" }}
  {{- $exposureCertEnabled = $exposureCert.enabled }}
{{- end }}
{{- $exposureCertIssuerRef := $exposureCert.issuerRef | default dict }}
{{- $exposureCertIssuerRef = dict
  "name" ($exposureCertIssuerRef.name | default "cloudflare-cluster-issuer")
  "kind" ($exposureCertIssuerRef.kind | default "ClusterIssuer")
}}
{{- $exposureCertSecretName := $exposureCert.secretName | default (printf "%s-exposure-tls" $namespace) }}
{{- $exposureCertSecretNamespace := $exposureCert.secretNamespace | default "istio-ingress" }}

{{- $exposureRedis := $exposure.redis | default dict }}
{{- $exposureRedis = dict
  "size" ($exposureRedis.size | default "1Gi")
  "storageClassName" ($exposureRedis.storageClassName | default "")
  "image" ($exposureRedis.image | default "mirror.gcr.io/redis:7-alpine")
}}

{{- $exposureProxy := $exposure.oauth2Proxy | default dict }}
{{- $exposureProxyCookieDomain := $exposureProxy.cookieDomain | default (printf ".%s" $exposureDomain) }}
{{- $exposureProxyCookieRef := $exposureProxy.cookieSecretRef | default dict }}
{{- $exposureProxyCookieRef = dict
  "name" ($exposureProxyCookieRef.name | default "")
  "key" ($exposureProxyCookieRef.key | default "cookie_secret")
}}
{{- if and $exposureEnabled (eq $exposureProxyCookieRef.name "") }}
  {{- fail "spec.exposure.oauth2Proxy.cookieSecretRef.name is required when spec.exposure.enabled is true (operator pre-creates the Secret holding the cookie-signing key)" }}
{{- end }}
{{- $haOauth2Proxy := get $haComponents "oauth2Proxy" | default dict }}
{{- $exposureProxyReplicas := 1 }}
{{- if and $haEnabled $haOauth2Proxy.enabled }}
  {{- $exposureProxyReplicas = $haOauth2Proxy.replicas }}
{{- end }}
{{- if hasKey $exposureProxy "replicas" }}
  {{- $exposureProxyReplicas = $exposureProxy.replicas }}
{{- end }}
{{- $exposureProxy = dict
  "image" ($exposureProxy.image | default "quay.io/oauth2-proxy/oauth2-proxy:v7.7.1")
  "replicas" $exposureProxyReplicas
  "additionalConfig" ($exposureProxy.additionalConfig | default list)
  "cookieDomain" $exposureProxyCookieDomain
  "cookieSecretRef" $exposureProxyCookieRef
}}

{{- /* Waypoint name — composed by 445-* and referenced from sister Services + ext_authz provider naming. */}}
{{- $exposureWaypointName := printf "%s-waypoint" $namespace }}

{{- /* Chart-default pod selectors (kube-prometheus-stack v77.x + opencost chart conventions).
       Operators override per cluster via spec.exposure.<comp>.podSelector when on a different chart version. */}}
{{- $defaultPodSelectors := dict
  "prometheus" (dict
    "app.kubernetes.io/name" "prometheus"
    "prometheus" "kube-prometheus-stack-prometheus"
  )
  "alertmanager" (dict
    "app.kubernetes.io/name" "alertmanager"
    "alertmanager" "kube-prometheus-stack-alertmanager"
  )
  "opencost" (dict
    "app.kubernetes.io/name" "opencost"
  )
  "grafana" (dict
    "app.kubernetes.io/name" "grafana"
    "app.kubernetes.io/instance" "kube-prometheus-stack"
  )
}}

{{- /* authMode discriminator per component:
       - ext_authz: gated via AuthorizationPolicy.CUSTOM + oauth2-proxy ext_authz
       - app_level: app speaks OIDC itself; no AuthorizationPolicy, no /oauth2/* HTTPRoute rule.
       See feedback_app_level_oidc. */}}
{{- $defaultAuthMode := dict
  "prometheus" "ext_authz"
  "alertmanager" "ext_authz"
  "opencost" "ext_authz"
  "grafana" "app_level"
}}

{{- $exposureComponents := list }}
{{- range $compName := list "prometheus" "alertmanager" "opencost" "grafana" }}
  {{- $comp := get $exposure $compName | default dict }}
  {{- $compEnabled := false }}
  {{- if hasKey $comp "enabled" }}
    {{- $compEnabled = $comp.enabled }}
  {{- end }}
  {{- $compHost := $comp.host | default "" }}
  {{- if and $exposureEnabled $compEnabled (eq $compHost "") }}
    {{- fail (printf "spec.exposure.%s.host is required when spec.exposure.%s.enabled is true" $compName $compName) }}
  {{- end }}
  {{- $compSvcName := $comp.serviceName | default "" }}
  {{- $compSvcPort := $comp.servicePort | default 0 }}
  {{- if eq $compName "prometheus" }}
    {{- $compSvcName = $comp.serviceName | default "kube-prometheus-stack-prometheus" }}
    {{- $compSvcPort = $comp.servicePort | default 9090 }}
  {{- else if eq $compName "alertmanager" }}
    {{- $compSvcName = $comp.serviceName | default "kube-prometheus-stack-alertmanager" }}
    {{- $compSvcPort = $comp.servicePort | default 9093 }}
  {{- else if eq $compName "opencost" }}
    {{- $compSvcName = $comp.serviceName | default "opencost" }}
    {{- $compSvcPort = $comp.servicePort | default 9090 }}
  {{- else if eq $compName "grafana" }}
    {{- $compSvcName = $comp.serviceName | default "grafana" }}
    {{- $compSvcPort = $comp.servicePort | default 80 }}
  {{- end }}
  {{- $defaultSel := get $defaultPodSelectors $compName | default dict }}
  {{- $compPodSelector := $comp.podSelector | default $defaultSel }}
  {{- $compAuthMode := get $defaultAuthMode $compName | default "ext_authz" }}
  {{- $exposureComponents = append $exposureComponents (dict
    "name" $compName
    "enabled" $compEnabled
    "host" $compHost
    "serviceName" $compSvcName
    "servicePort" $compSvcPort
    "podSelector" $compPodSelector
    "authMode" $compAuthMode
    "sisterServiceName" (printf "exposure-%s" $compName)
  ) }}
{{- end }}

{{- /* Grafana app-level OIDC config (extracted into its own struct so the
       Grafana Helm-values template can reference it cleanly). */}}
{{- $exposureGrafana := $exposure.grafana | default dict }}
{{- $exposureGrafanaCfg := dict
  "enabled" (and $exposureEnabled (hasKey $exposureGrafana "enabled") $exposureGrafana.enabled)
  "host" ($exposureGrafana.host | default "")
  "allowedDomains" ($exposureGrafana.allowedDomains | default list)
  "roleAttributePath" ($exposureGrafana.roleAttributePath | default "")
  "maxSessionDuration" ($exposureGrafana.maxSessionDuration | default "8h")
  "tokenRotationMinutes" ($exposureGrafana.tokenRotationMinutes | default 10)
  "useRefreshToken" (or (not (hasKey $exposureGrafana "useRefreshToken")) $exposureGrafana.useRefreshToken)
  "autoLogin" (and (hasKey $exposureGrafana "autoLogin") $exposureGrafana.autoLogin)
  "orgAttributePath" ($exposureGrafana.orgAttributePath | default "")
  "orgMapping" ($exposureGrafana.orgMapping | default list)
}}

# ==============================================================================
# Initialize $state
# ==============================================================================
{{- $state := dict
  "name" $name
  "clusterName" $clusterName
  "namespace" $namespace
  "managementPolicies" $managementPolicies
  "labels" $labels
  "helm" (dict
    "providerConfigRef" $helmProviderConfigRef
  )
  "kubernetes" (dict
    "providerConfigRef" $kubernetesProviderConfigRef
  )
  "aws" (dict
    "region" $awsRegion
    "providerConfigRef" $awsProviderConfigRef
    "permissionsBoundaryArn" ($aws.permissionsBoundaryArn | default "")
    "rolePrefix" ($aws.rolePrefix | default "")
    "tags" $awsTags
    "loki" (dict
      "retentionDays" $lokiRetentionDays
      "s3" (dict
        "enabled" $lokiS3Enabled
        "bucketName" $lokiS3BucketName
      )
      "pvc" (dict
        "size" $lokiPVCSize
        "storageClass" $lokiStorageClass
      )
      "serviceAccount" (dict
        "name" "loki"
        "namespace" $namespace
      )
    )
    "tempo" (dict
      "retentionDays" $tempoRetentionDays
      "s3" (dict
        "enabled" $tempoS3Enabled
        "bucketName" $tempoS3BucketName
      )
      "pvc" (dict
        "size" $tempoPVCSize
        "storageClass" $tempoStorageClass
      )
      "serviceAccount" (dict
        "name" "tempo"
        "namespace" $namespace
      )
    )
    "prometheus" (dict
      "retentionDays" $prometheusRetentionDays
      "pvc" (dict
        "size" $prometheusPVCSize
        "storageClass" $prometheusStorageClass
      )
    )
  )
  "podIdentitySuffix" ""
  "serviceAccount" (dict
    "name" $opencostServiceAccountName
    "namespace" $namespace
  )
  "kubePrometheusStack" (dict
    "name" $kubePrometheusStackReleaseName
    "fullname" $kubePrometheusStackFullname
    "grafanaServiceName" $kubePrometheusStackGrafanaServiceName
    "prometheusServiceName" (printf "%s-prometheus" $kubePrometheusStackFullname)
    "namespace" ($kubePrometheusStack.namespace | default $namespace)
    "values" ($kubePrometheusStack.values | default dict)
    "overrideAllValues" ($kubePrometheusStack.overrideAllValues | default dict)
  )
  "loki" (dict
    "name" ($loki.name | default "loki")
    "namespace" ($loki.namespace | default $namespace)
    "values" ($loki.values | default dict)
    "overrideAllValues" ($loki.overrideAllValues | default dict)
  )
  "tempo" (dict
    "name" ($tempo.name | default "tempo")
    "namespace" ($tempo.namespace | default $namespace)
    "values" ($tempo.values | default dict)
    "overrideAllValues" ($tempo.overrideAllValues | default dict)
  )
  "k8sMonitoring" (dict
    "name" ($k8sMonitoring.name | default "k8s-monitoring")
    "namespace" ($k8sMonitoring.namespace | default $namespace)
    "values" ($k8sMonitoring.values | default dict)
    "overrideAllValues" ($k8sMonitoring.overrideAllValues | default dict)
  )
  "grafanaOperator" (dict
    "name" ($grafanaOperator.name | default "grafana-operator")
    "namespace" ($grafanaOperator.namespace | default $namespace)
    "values" ($grafanaOperator.values | default dict)
    "overrideAllValues" ($grafanaOperator.overrideAllValues | default dict)
  )
  "vpa" (dict
    "name" ($vpa.name | default "vpa")
    "namespace" ($vpa.namespace | default $namespace)
    "values" ($vpa.values | default dict)
    "overrideAllValues" ($vpa.overrideAllValues | default dict)
  )
  "goldilocks" (dict
    "name" ($goldilocks.name | default "goldilocks")
    "namespace" ($goldilocks.namespace | default $namespace)
    "values" ($goldilocks.values | default dict)
    "overrideAllValues" ($goldilocks.overrideAllValues | default dict)
  )
  "metricsServer" (dict
    "enabled" $metricsServerEnabled
    "name" "metrics-server"
    "namespace" ($metricsServer.namespace | default "kube-system")
    "values" ($metricsServer.values | default dict)
    "overrideAllValues" ($metricsServer.overrideAllValues | default dict)
  )
  "nodePool" (dict
    "enabled" $nodePoolEnabled
    "name" $nodePoolName
    "nodeClassName" $nodePoolNodeClassName
    "limits" $nodePoolLimits
    "requirements" $nodePoolRequirements
    "disruption" $nodePoolDisruption
    "taintKey" $nodePoolTaintKey
    "taintValue" $nodePoolTaintValue
    "nodeSelector" $nodePoolNodeSelector
    "tolerations" $nodePoolTolerations
  )
  "ha" (dict
    "enabled" $haEnabled
    "replicas" $haReplicas
    "pdb" (dict
      "enabled" $haPdbEnabled
      "minAvailable" $haPdbMinAvailable
    )
    "prometheus" (get $haComponents "prometheus")
    "alertmanager" (get $haComponents "alertmanager")
    "grafana" (get $haComponents "grafana")
    "opencost" (get $haComponents "opencost")
    "loki" (get $haComponents "loki")
    "tempo" (get $haComponents "tempo")
    "oauth2Proxy" (get $haComponents "oauth2Proxy")
    "redis" (get $haComponents "redis")
  )
  "spotFeed" (dict
    "enabled" $spotFeedEnabled
    "bucketName" ($spotFeed.bucketName | default "")
    "region" ($spotFeed.region | default $awsRegion)
    "accountId" ($spotFeed.accountId | default "")
    "prefix" ($spotFeed.prefix | default "")
  )
  "cloudCosts" (dict
    "enabled" $cloudCostsEnabled
    "secretName" $cloudCostsSecretName
    "bucketName" $cloudCostsBucketName
    "region" $cloudCostsRegion
    "accountId" $cloudCostsAccountId
    "databaseName" $cloudCostsDatabaseName
    "tableName" $cloudCostsTableName
    "workgroupName" $cloudCostsWorkgroupName
    "costReportRef" (dict
      "enabled" $cloudCostsCostReportRefEnabled
      "name" $cloudCostsCostReportRefName
      "namespace" ($cloudCostsCostReportRef.namespace | default ($metadata.namespace | default "default"))
      "accountId" ($cloudCostsCostReportRef.accountId | default "")
      "region" ($cloudCostsCostReportRef.region | default $awsRegion)
      "bucketName" ($cloudCostsCostReportRef.bucketName | default "")
      "reportName" ($cloudCostsCostReportRef.reportName | default "")
      "databaseName" ($cloudCostsCostReportRef.databaseName | default "")
      "workgroupName" ($cloudCostsCostReportRef.workgroupName | default "")
    )
  )
  "auth" (dict
    "authStackRef" (dict
      "name" ($authStackRef.name | default "")
      "namespace" ($authStackRef.namespace | default "")
    )
    "issuerURL" $authIssuerURL
    "zitadelDomain" $authZitadelDomain
    "awsSecretsManagerPath" $authAwsSmPath
    "accessTokenProperty" $authAccessTokenProperty
    "zitadelProjectId" $authProjectId
  )
  "exposure" (dict
    "enabled" $exposureEnabled
    "domain" $exposureDomain
    "gatewayRef" $exposureGatewayRef
    "extensionProviderName" $exposureExtProviderName
    "waypointName" $exposureWaypointName
    "certificate" (dict
      "enabled" $exposureCertEnabled
      "issuerRef" $exposureCertIssuerRef
      "secretName" $exposureCertSecretName
      "secretNamespace" $exposureCertSecretNamespace
    )
    "redis" $exposureRedis
    "oauth2Proxy" $exposureProxy
    "components" $exposureComponents
    "grafana" $exposureGrafanaCfg
  )
  "observed" (dict)
  "status" (dict)
}}
