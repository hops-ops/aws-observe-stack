# code: language=yaml
#
# AWS S3 storage for Tempo (only when tempo.storage.type=s3)
#

{{- if $state.aws.tempo.s3.enabled }}

{{- $bucketName := $state.aws.tempo.s3.bucketName }}
{{- $retentionDays := $state.aws.tempo.retentionDays }}
{{- $lifecycleDays := add $retentionDays 7 }}
{{- $tempoBucketExists := ne $state.observed.tempoBucket.id "" }}
{{- $tempoStorageKeyExists := ne $state.observed.tempoStorageKey.id "" }}
{{- $tempoStorageKeyArn := $state.observed.tempoStorageKey.arn | default "" }}

# ==============================================================================
# KMS key for Tempo storage encryption
# ==============================================================================
---
apiVersion: kms.aws.m.upbound.io/v1beta1
kind: Key
metadata:
  name: {{ $state.name }}-tempo-storage
  annotations:
    {{ setResourceNameAnnotation "tempo-storage-key" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    deletionWindowInDays: 7
    description: KMS key for Tempo object storage in {{ $state.clusterName }}
    enableKeyRotation: true
    region: {{ $state.aws.region }}
    tags: {{ merge (dict "Name" (printf "%s-tempo-storage" $state.name)) $state.aws.tags | toJson }}
  providerConfigRef:
    name: {{ $state.aws.providerConfigRef.name }}
    kind: {{ $state.aws.providerConfigRef.kind }}

# ==============================================================================
# S3 Bucket for Tempo storage
# ==============================================================================
---
apiVersion: s3.aws.m.upbound.io/v1beta1
kind: Bucket
metadata:
  name: {{ $state.name }}-tempo-bucket
  annotations:
    {{ setResourceNameAnnotation "tempo-bucket" }}
    crossplane.io/external-name: {{ $bucketName }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    region: {{ $state.aws.region }}
    tags:
      {{ $state.aws.tags | toYaml | nindent 6 }}
  providerConfigRef:
    name: {{ $state.aws.providerConfigRef.name }}
    kind: {{ $state.aws.providerConfigRef.kind }}

{{- if $tempoBucketExists }}
# ==============================================================================
# Block all public access
# ==============================================================================
---
apiVersion: s3.aws.m.upbound.io/v1beta1
kind: BucketPublicAccessBlock
metadata:
  name: {{ $state.name }}-tempo-bucket-pab
  annotations:
    {{ setResourceNameAnnotation "tempo-bucket-pab" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    region: {{ $state.aws.region }}
    bucketRef:
      name: {{ $state.name }}-tempo-bucket
    blockPublicAcls: true
    blockPublicPolicy: true
    ignorePublicAcls: true
    restrictPublicBuckets: true
  providerConfigRef:
    name: {{ $state.aws.providerConfigRef.name }}
    kind: {{ $state.aws.providerConfigRef.kind }}

{{- end }}

{{- if and $tempoBucketExists $tempoStorageKeyExists }}
# ==============================================================================
# Default bucket encryption: SSE-KMS with the Tempo storage key
# ==============================================================================
---
apiVersion: s3.aws.m.upbound.io/v1beta1
kind: BucketServerSideEncryptionConfiguration
metadata:
  name: {{ $state.name }}-tempo-bucket-encryption
  annotations:
    {{ setResourceNameAnnotation "tempo-bucket-encryption" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    region: {{ $state.aws.region }}
    bucketRef:
      name: {{ $state.name }}-tempo-bucket
    rule:
    - applyServerSideEncryptionByDefault:
        kmsMasterKeyIdRef:
          name: {{ $state.name }}-tempo-storage
        sseAlgorithm: aws:kms
      bucketKeyEnabled: true
  providerConfigRef:
    name: {{ $state.aws.providerConfigRef.name }}
    kind: {{ $state.aws.providerConfigRef.kind }}

{{- end }}

{{- if $tempoBucketExists }}
# ==============================================================================
# Lifecycle: expire objects after retentionDays + 7
# ==============================================================================
---
apiVersion: s3.aws.m.upbound.io/v1beta1
kind: BucketLifecycleConfiguration
metadata:
  name: {{ $state.name }}-tempo-bucket-lifecycle
  annotations:
    {{ setResourceNameAnnotation "tempo-bucket-lifecycle" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    region: {{ $state.aws.region }}
    bucketRef:
      name: {{ $state.name }}-tempo-bucket
    rule:
    - id: expire-old-data
      status: Enabled
      filter:
      - prefix: ""
      expiration:
      - days: {{ $lifecycleDays }}
  providerConfigRef:
    name: {{ $state.aws.providerConfigRef.name }}
    kind: {{ $state.aws.providerConfigRef.kind }}
{{- end }}

# ==============================================================================
# PodIdentity for Tempo service account with S3 permissions
# ==============================================================================
{{- if $tempoStorageKeyArn }}
---
apiVersion: aws.hops.ops.com.ai/v1alpha1
kind: PodIdentity
metadata:
  name: {{ $state.name }}-tempo{{ $state.podIdentitySuffix }}
  annotations:
    {{ setResourceNameAnnotation "tempo-pod-identity" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  clusterName: {{ $state.clusterName }}
  region: {{ $state.aws.region }}
  providerConfigRef:
    name: {{ $state.aws.providerConfigRef.name }}
    kind: {{ $state.aws.providerConfigRef.kind }}
  {{- if $state.aws.rolePrefix }}
  rolePrefix: {{ $state.aws.rolePrefix }}
  {{- end }}
  {{- if $state.aws.permissionsBoundaryArn }}
  permissionsBoundaryArn: {{ $state.aws.permissionsBoundaryArn }}
  {{- end }}
  serviceAccount:
    name: {{ $state.aws.tempo.serviceAccount.name }}
    namespace: {{ $state.aws.tempo.serviceAccount.namespace }}
  inlinePolicy:
    - name: tempo-s3-storage
      policy: |
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads"],
              "Resource": "arn:aws:s3:::{{ $bucketName }}"
            },
            {
              "Effect": "Allow",
              "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
              "Resource": "arn:aws:s3:::{{ $bucketName }}/*"
            },
            {
              "Effect": "Allow",
              "Action": ["kms:Decrypt", "kms:Encrypt", "kms:GenerateDataKey", "kms:DescribeKey"],
              "Resource": "{{ $tempoStorageKeyArn }}",
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "s3.{{ $state.aws.region }}.amazonaws.com"
                }
              }
            }
          ]
        }
  tags: {{ $state.aws.tags | toJson }}

# ==============================================================================
# Usage: Protect Tempo PodIdentity from deletion until Tempo Release is deleted
# ==============================================================================
{{- $tempoPodIdentityAssociationName := printf "%s-%s-tempo%s" $state.clusterName $state.name $state.podIdentitySuffix }}
{{- if and $state.observed.tempo.ready $state.observed.tempoPodIdentity.ready }}
---
apiVersion: protection.crossplane.io/v1beta1
kind: Usage
metadata:
  name: {{ $state.name }}-delete-tempo-before-tempo-pod-identity
  annotations:
    {{ setResourceNameAnnotation "usage-tempo-pod-identity" }}
  labels: {{ $state.labels | toJson }}
spec:
  replayDeletion: true
  of:
    apiVersion: eks.aws.m.upbound.io/v1beta1
    kind: PodIdentityAssociation
    resourceRef:
      name: {{ $tempoPodIdentityAssociationName }}
  by:
    apiVersion: helm.m.crossplane.io/v1beta1
    kind: Release
    resourceRef:
      name: {{ $state.tempo.name }}
{{- end }}
{{- end }}

{{- end }}
