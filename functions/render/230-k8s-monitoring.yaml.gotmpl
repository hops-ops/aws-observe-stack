# code: language=yaml
#
# Helm Release: k8s-monitoring
#
# Chart defaults with destinations wired to Prometheus, Loki, and Tempo.
#

{{- $k8sMon := $state.k8sMonitoring }}
{{- $kps := $state.kubePrometheusStack }}
{{- $loki := $state.loki }}
{{- $tempo := $state.tempo }}

---
apiVersion: helm.m.crossplane.io/v1beta1
kind: Release
metadata:
  name: {{ $k8sMon.name }}
  annotations:
    {{ setResourceNameAnnotation "k8s-monitoring" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    chart:
      name: k8s-monitoring
      repository: https://grafana.github.io/helm-charts
      # renovate: datasource=helm depName=k8s-monitoring registryUrl=https://grafana.github.io/helm-charts
      version: 4.5.0
    namespace: {{ $k8sMon.namespace }}
    {{- if $k8sMon.overrideAllValues }}
    values:
      {{- toYaml $k8sMon.overrideAllValues | nindent 6 }}
    {{- else }}
    {{- /* Pin OpenCost to a version where missing RI data is logged as WARN instead of ERR. */}}
    # renovate: datasource=docker depName=kubecost1/opencost registryUrl=https://quay.io
    {{- $opencostImageTag := "1.120.0" }}
    {{- /* Resource defaults. opencost exporter and UI are restart-cheap, so Burstable
         with low requests + headroom-to-burst. alloy-metrics is Guaranteed (chart docs
         warn 400 MiB OOMs on real clusters). DaemonSets stay Burstable + small.
         See references/karpenter-resource-best-practices §7.2. */}}
    {{- $opencostExporterResources := dict
      "requests" (dict "cpu" "50m" "memory" "128Mi")
      "limits" (dict "cpu" "100m" "memory" "256Mi")
    }}
    {{- $opencostUiResources := dict
      "requests" (dict "cpu" "10m" "memory" "32Mi")
      "limits" (dict "cpu" "50m" "memory" "128Mi")
    }}
    {{- /* alloy-metrics holds discovered targets + remote-write WAL. Chart
         example is 512Mi but k8s-monitoring-helm#541 shows that's
         optimistic; real clusters with prometheus-operator-objects
         enabled and many ServiceMonitors need 1Gi+. Crossplane-heavy
         clusters with hundreds of CRDs being scraped need >2Gi target memory
         per Goldilocks once steady-state series volume settles. */}}
    {{- $alloyMetricsResources := dict
      "requests" (dict "cpu" "200m" "memory" "2560Mi")
      "limits" (dict "memory" "2560Mi")
    }}
    {{- $alloySingletonResources := dict
      "requests" (dict "cpu" "50m" "memory" "128Mi")
      "limits" (dict "cpu" "100m" "memory" "256Mi")
    }}
    {{- $alloyReceiverResources := dict
      "requests" (dict "cpu" "50m" "memory" "128Mi")
      "limits" (dict "cpu" "200m" "memory" "512Mi")
    }}
    {{- $alloyLogsResources := dict
      "requests" (dict "cpu" "50m" "memory" "128Mi")
      "limits" (dict "cpu" "100m" "memory" "256Mi")
    }}
    {{- $alloyOperatorResources := dict
      "requests" (dict "cpu" "63m" "memory" "156Mi")
      "limits" (dict "cpu" "250m" "memory" "384Mi")
    }}
    {{- $nodeExporterResources := dict
      "requests" (dict "cpu" "50m" "memory" "32Mi")
      "limits" (dict "cpu" "100m" "memory" "64Mi")
    }}
    {{- /* OpenCost values — deployment, gets nodeSelector + tolerations */}}
    {{- $opencostValues := dict
      "enabled" true
      "metricsSource" "prometheus"
      "opencost" (dict
        "exporter" (dict
          "defaultClusterId" $state.clusterName
          "image" (dict "tag" $opencostImageTag)
          "extraEnv" (dict
            "CLOUD_COST_CONFIG_PATH" "/var/configs/cloud-integration/cloud-integration.json"
            "PLUGIN_CONFIG_DIR" "/var/configs"
          )
          "resources" $opencostExporterResources
        )
        "prometheus" (dict "external" (dict "url" (printf "http://%s.%s:9090" $kps.prometheusServiceName $kps.namespace)))
        "ui" (dict
          "enabled" true
          "image" (dict "tag" $opencostImageTag)
          "resources" $opencostUiResources
        )
      )
    }}
    {{- /* DaemonSets (alloy-logs, alloy-receiver) tolerate ALL taints so they run on
         every node, including dedicated NodePools (crossplane, observe, etc.) */}}
    {{- $tolerateAll := list (dict "operator" "Exists") }}
    {{- /* For alloy-* the chart wraps an Alloy CR (spec.alloy.resources). The key
         is `alloy.resources`, not bare `resources`. alloy-operator is the operator
         helm release (not a CR wrapper) so uses bare `resources`. */}}
    {{- $alloyLogs := dict
      "enabled" true
      "controller" (dict "tolerations" $tolerateAll)
      "alloy" (dict "resources" $alloyLogsResources)
    }}
    {{- $alloyReceiver := dict
      "enabled" true
      "controller" (dict "tolerations" $tolerateAll)
      "alloy" (dict "resources" $alloyReceiverResources)
    }}
    {{- /* alloy-metrics (StatefulSet), alloy-singleton, and alloy-operator
         get nodeSelector + tolerations when nodePool enabled; otherwise no scheduling constraints */}}
    {{- $alloyMetrics := dict "enabled" true "alloy" (dict "resources" $alloyMetricsResources) }}
    {{- $alloySingleton := dict "enabled" true "alloy" (dict "resources" $alloySingletonResources) }}
    {{- $alloyOperator := dict "resources" $alloyOperatorResources }}
    {{- $nodeExporterValues := dict "enabled" true "resources" $nodeExporterResources }}
    {{- if $state.nodePool.enabled }}
      {{- $existingOpencost := $opencostValues.opencost | default dict }}
      {{- $_ := set $existingOpencost "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $existingOpencost "tolerations" $state.nodePool.tolerations }}
      {{- $_ := set $opencostValues "opencost" $existingOpencost }}
      {{- $_ := set $alloyMetrics "controller" (dict "nodeSelector" $state.nodePool.nodeSelector "tolerations" $state.nodePool.tolerations) }}
      {{- $_ := set $alloySingleton "controller" (dict "nodeSelector" $state.nodePool.nodeSelector "tolerations" $state.nodePool.tolerations) }}
      {{- $_ := set $alloyOperator "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $alloyOperator "tolerations" $state.nodePool.tolerations }}
    {{- end }}
    {{- $enableCustomPricing := or $state.spotFeed.enabled $state.cloudCosts.enabled }}
    {{- if $enableCustomPricing }}
      {{- $costModel := dict }}
      {{- if $state.cloudCosts.enabled }}
        {{- $_ := set $costModel "athenaBucketName" (printf "s3://%s/athena-results" $state.cloudCosts.bucketName) }}
        {{- $_ := set $costModel "athenaRegion" $state.cloudCosts.region }}
        {{- $_ := set $costModel "athenaDatabase" $state.cloudCosts.databaseName }}
        {{- $_ := set $costModel "athenaTable" $state.cloudCosts.tableName }}
        {{- $_ := set $costModel "athenaWorkgroup" $state.cloudCosts.workgroupName }}
        {{- $_ := set $costModel "projectID" $state.cloudCosts.accountId }}
        {{- $_ := set $costModel "athenaProjectID" $state.cloudCosts.accountId }}
      {{- end }}
      {{- if $state.spotFeed.enabled }}
        {{- $_ := set $costModel "awsSpotDataBucket" $state.spotFeed.bucketName }}
        {{- $_ := set $costModel "awsSpotDataRegion" $state.spotFeed.region }}
        {{- if not (hasKey $costModel "projectID") }}
          {{- $_ := set $costModel "projectID" $state.spotFeed.accountId }}
        {{- end }}
        {{- if not (hasKey $costModel "athenaProjectID") }}
          {{- $_ := set $costModel "athenaProjectID" $state.spotFeed.accountId }}
        {{- end }}
        {{- $_ := set $costModel "spotLabel" "karpenter.sh/capacity-type" }}
        {{- $_ := set $costModel "spotLabelValue" "spot" }}
      {{- end }}
      {{- if $state.spotFeed.prefix }}
        {{- $_ := set $costModel "awsSpotDataPrefix" $state.spotFeed.prefix }}
      {{- end }}
      {{- $existingOpencost := $opencostValues.opencost | default dict }}
      {{- $_ := set $existingOpencost "customPricing" (dict
        "enabled" true
        "provider" "aws"
        "costModel" $costModel
      ) }}
      {{- $_ := set $opencostValues "opencost" $existingOpencost }}
    {{- end }}
    {{- if $state.cloudCosts.enabled }}
      {{- $existingOpencost := $opencostValues.opencost | default dict }}
      {{- $_ := set $existingOpencost "cloudCost" (dict "enabled" true) }}
      {{- $_ := set $existingOpencost "cloudIntegrationSecret" $state.cloudCosts.secretName }}
      {{- $_ := set $opencostValues "opencost" $existingOpencost }}
    {{- end }}
    {{- $_ := set $opencostValues "fullnameOverride" "opencost" }}
    {{- $_ := set $alloyMetrics "fullnameOverride" "alloy-metrics" }}
    {{- $_ := set $alloySingleton "fullnameOverride" "alloy-singleton" }}
    {{- $_ := set $alloyReceiver "fullnameOverride" "alloy-receiver" }}
    {{- $_ := set $alloyOperator "fullnameOverride" "alloy-operator" }}
    {{- $_ := set $alloyLogs "fullnameOverride" "alloy-logs" }}
    {{- $_ := set $nodeExporterValues "fullnameOverride" "node-exporter" }}
    {{- $defaults := dict
      "cluster" (dict "name" $state.clusterName)
      "destinations" (list
        (dict "name" "prometheus" "type" "prometheus" "url" (printf "http://%s.%s:9090/api/v1/write" $kps.prometheusServiceName $kps.namespace))
        (dict "name" "loki" "type" "loki" "url" (printf "http://%s-gateway.%s:80/loki/api/v1/push" $loki.name $loki.namespace))
        (dict "name" "tempo" "type" "otlp" "protocol" "grpc" "url" (printf "http://%s.%s:4317" $tempo.name $tempo.namespace))
      )
      "clusterMetrics" (dict
        "enabled" true
        "kube-state-metrics" (dict "deploy" false)
        "opencost" $opencostValues
        "node-exporter" $nodeExporterValues
      )
      "alloy-metrics" $alloyMetrics
      "clusterEvents" (dict "enabled" true)
      "nodeLogs" (dict "enabled" true)
      "podLogs" (dict "enabled" true)
      "applicationObservability" (dict
        "enabled" true
        "receivers" (dict
          "otlp" (dict
            "grpc" (dict "enabled" true "port" 4317)
            "http" (dict "enabled" true "port" 4318)
          )
        )
      )
      "prometheusOperatorObjects" (dict "enabled" true)
      "alloy-logs" $alloyLogs
      "alloy-singleton" $alloySingleton
      "alloy-receiver" $alloyReceiver
      "alloy-operator" $alloyOperator
      "nodeExporter" (dict "enabled" false)
    }}
    {{- $merged := mustMergeOverwrite $defaults ($k8sMon.values | default dict) }}
    values:
      {{- toYaml $merged | nindent 6 }}
    {{- end }}
  rollbackLimit: 3
  providerConfigRef:
    name: {{ $state.helm.providerConfigRef.name }}
    kind: {{ $state.helm.providerConfigRef.kind }}
