# code: language=yaml
#
# Helm Release: loki
#
# Chart defaults (SingleBinary mode) with AWS S3 or PVC storage config.
#

{{- $loki := $state.loki }}

---
apiVersion: helm.m.crossplane.io/v1beta1
kind: Release
metadata:
  name: {{ $loki.name }}
  annotations:
    {{ setResourceNameAnnotation "loki" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    chart:
      name: loki
      repository: https://grafana.github.io/helm-charts
      # renovate: datasource=helm depName=loki registryUrl=https://grafana.github.io/helm-charts
      version: 6.55.0
    namespace: {{ $loki.namespace }}
    {{- if $loki.overrideAllValues }}
    values:
      {{- toYaml $loki.overrideAllValues | nindent 6 }}
    {{- else }}
    {{- $lokiConfig := dict
      "auth_enabled" false
      "commonConfig" (dict "replication_factor" 1)
    }}
    {{- if $state.aws.loki.s3.enabled }}
    {{- $_ := set $lokiConfig "storage" (dict
      "type" "s3"
      "bucketNames" (dict "chunks" $state.aws.loki.s3.bucketName "ruler" $state.aws.loki.s3.bucketName "admin" $state.aws.loki.s3.bucketName)
      "s3" (dict "region" $state.aws.region)
    ) }}
    {{- $_ := set $lokiConfig "schemaConfig" (dict
      "configs" (list (dict "from" "2024-04-01" "store" "tsdb" "object_store" "s3" "schema" "v13" "index" (dict "prefix" "loki_index_" "period" "24h")))
    ) }}
    {{- else }}
    {{- $_ := set $lokiConfig "storage" (dict "type" "filesystem") }}
    {{- $_ := set $lokiConfig "schemaConfig" (dict
      "configs" (list (dict "from" "2024-04-01" "store" "tsdb" "object_store" "filesystem" "schema" "v13" "index" (dict "prefix" "index_" "period" "24h")))
    ) }}
    {{- end }}
    {{- $deleteRequestStore := "filesystem" }}
    {{- if $state.aws.loki.s3.enabled }}
    {{- $deleteRequestStore = "s3" }}
    {{- end }}
    {{- $_ := set $lokiConfig "compactor" (dict "retention_enabled" true "delete_request_store" $deleteRequestStore) }}
    {{- $_ := set $lokiConfig "limits_config" (dict
      "retention_period" (printf "%vh" (mul $state.aws.loki.retentionDays 24))
      "volume_enabled" true
      "allow_structured_metadata" true
      "otlp_config" (dict
        "resource_attributes" (dict
          "attributes_config" (list (dict
            "action" "index_label"
            "attributes" (list "service.name" "service.namespace" "k8s.namespace.name" "k8s.pod.name" "k8s.container.name")
          ))
        )
      )
    ) }}
    {{- /* Resource defaults. singleBinary is stateful (holds chunks in memory) so
         Guaranteed. Gateway, canary, and caches are Burstable.
         See references/karpenter-resource-best-practices §7.3. */}}
    {{- $singleBinaryResources := dict
      "requests" (dict "cpu" "500m" "memory" "2Gi")
      "limits" (dict "memory" "2Gi")
    }}
    {{- $gatewayResources := dict
      "requests" (dict "cpu" "50m" "memory" "64Mi")
      "limits" (dict "cpu" "100m" "memory" "128Mi")
    }}
    {{- $canaryResources := dict
      "requests" (dict "cpu" "10m" "memory" "32Mi")
      "limits" (dict "cpu" "50m" "memory" "64Mi")
    }}
    {{- $cacheResources := dict
      "requests" (dict "cpu" "50m" "memory" "128Mi")
      "limits" (dict "cpu" "100m" "memory" "256Mi")
    }}
    {{- $singleBinary := dict "replicas" 1 "resources" $singleBinaryResources }}
    {{- if and $state.ha.loki.enabled $state.aws.loki.s3.enabled }}
      {{- $commonConfig := get $lokiConfig "commonConfig" | default dict }}
      {{- $_ := set $commonConfig "replication_factor" $state.ha.loki.replicas }}
      {{- $_ := set $lokiConfig "commonConfig" $commonConfig }}
      {{- $_ := set $singleBinary "replicas" $state.ha.loki.replicas }}
      {{- $_ := set $singleBinary "topologySpreadConstraints" (list (dict
        "maxSkew" 1
        "topologyKey" "topology.kubernetes.io/zone"
        "whenUnsatisfiable" "ScheduleAnyway"
        "labelSelector" (dict "matchLabels" (dict "app.kubernetes.io/name" "loki" "app.kubernetes.io/component" "single-binary"))
      )) }}
    {{- end }}
    {{- if not $state.aws.loki.s3.enabled }}
    {{- $_ := set $singleBinary "persistence" (dict "enabled" true "storageClass" $state.aws.loki.pvc.storageClass.name "size" $state.aws.loki.pvc.size) }}
    {{- end }}
    # renovate: datasource=docker depName=nginx/nginx-unprivileged registryUrl=https://quay.io
    {{- $gatewayImageTag := "1.31-alpine" }}
    # renovate: datasource=docker depName=library/memcached registryUrl=https://index.docker.io
    {{- $memcachedImageTag := "1.6.45-alpine" }}
    # renovate: datasource=docker depName=prometheus/memcached-exporter registryUrl=https://quay.io
    {{- $memcachedExporterImageTag := "v0.15.4" }}
    # renovate: datasource=docker depName=kiwigrid/k8s-sidecar registryUrl=https://ghcr.io
    {{- $sidecarImageTag := "1.30.11" }}
    {{- $gatewayValues := dict
      "enabled" true
      "resources" $gatewayResources
      "image" (dict "registry" "quay.io" "repository" "nginx/nginx-unprivileged" "tag" $gatewayImageTag)
    }}
    {{- $resultsCache := dict "resources" $cacheResources }}
    {{- $chunksCache := dict "resources" $cacheResources }}
    {{- $memcachedValues := dict
      "image" (dict "repository" "mirror.gcr.io/memcached" "tag" $memcachedImageTag)
    }}
    {{- $memcachedExporterValues := dict
      "image" (dict "repository" "quay.io/prometheus/memcached-exporter" "tag" $memcachedExporterImageTag)
    }}
    {{- $sidecarValues := dict
      "image" (dict "registry" "ghcr.io" "repository" "kiwigrid/k8s-sidecar" "tag" $sidecarImageTag)
    }}
    {{- if $state.nodePool.enabled }}
      {{- $_ := set $singleBinary "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $singleBinary "tolerations" $state.nodePool.tolerations }}
      {{- $_ := set $gatewayValues "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $gatewayValues "tolerations" $state.nodePool.tolerations }}
      {{- $_ := set $resultsCache "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $resultsCache "tolerations" $state.nodePool.tolerations }}
      {{- $_ := set $chunksCache "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $chunksCache "tolerations" $state.nodePool.tolerations }}
    {{- end }}
    {{- /* lokiCanary is a DaemonSet — tolerate all taints so it runs on every node */}}
    {{- $tolerateAll := list (dict "operator" "Exists") }}
    {{- $defaults := dict
      "loki" $lokiConfig
      "deploymentMode" "SingleBinary"
      "singleBinary" $singleBinary
      "resultsCache" $resultsCache
      "chunksCache" $chunksCache
      "read" (dict "replicas" 0)
      "write" (dict "replicas" 0)
      "backend" (dict "replicas" 0)
      "gateway" $gatewayValues
      "lokiCanary" (dict
        "tolerations" $tolerateAll
        "resources" $canaryResources
        "image" (dict "registry" "mirror.gcr.io" "repository" "grafana/loki-canary")
      )
      "memcached" $memcachedValues
      "memcachedExporter" $memcachedExporterValues
      "sidecar" $sidecarValues
    }}
    {{- $merged := mustMergeOverwrite $defaults ($loki.values | default dict) }}
    values:
      {{- toYaml $merged | nindent 6 }}
    {{- end }}
  rollbackLimit: 3
  providerConfigRef:
    name: {{ $state.helm.providerConfigRef.name }}
    kind: {{ $state.helm.providerConfigRef.kind }}
