# code: language=yaml
#
# Helm Release: goldilocks
#
# Goldilocks monitors all namespaces by default (on-by-default flag).
# Requires VPA to be installed for recommendations.
# Dashboard is enabled by default.
#

{{- $goldilocks := $state.goldilocks }}

---
apiVersion: helm.m.crossplane.io/v1beta1
kind: Release
metadata:
  name: {{ $goldilocks.name }}
  annotations:
    {{ setResourceNameAnnotation "goldilocks" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    chart:
      name: goldilocks
      repository: https://charts.fairwinds.com/stable
      {{- if hasKey $state.chartVersions "goldilocks" }}
      version: {{ index $state.chartVersions "goldilocks" | quote }}
      {{- else }}
      # renovate: datasource=helm depName=goldilocks registryUrl=https://charts.fairwinds.com/stable
      version: 11.2.0
      {{- end }}
    namespace: {{ $goldilocks.namespace }}
    {{- if $goldilocks.overrideAllValues }}
    values:
      {{- toYaml $goldilocks.overrideAllValues | nindent 6 }}
    {{- else }}
    {{- $controller := dict "flags" (dict "on-by-default" "true") }}
    {{- $dashboard := dict "enabled" true "flags" (dict "on-by-default" "true") }}
    {{- if $state.nodePool.enabled }}
      {{- $_ := set $controller "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $controller "tolerations" $state.nodePool.tolerations }}
      {{- $_ := set $dashboard "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $dashboard "tolerations" $state.nodePool.tolerations }}
    {{- end }}
    {{- $defaults := dict
      "controller" $controller
      "dashboard" $dashboard
    }}
    {{- $merged := mustMergeOverwrite $defaults ($goldilocks.values | default dict) }}
    values:
      {{- toYaml $merged | nindent 6 }}
    {{- end }}
  rollbackLimit: 3
  providerConfigRef:
    name: {{ $state.helm.providerConfigRef.name }}
    kind: {{ $state.helm.providerConfigRef.kind }}

{{- /* Keep this dependency until the protected Goldilocks route is removed. */}}
{{- range $comp := $state.exposure.components }}
{{- if and (eq $comp.name "goldilocks") $comp.enabled (ne $comp.host "") (get $checkReady "exposure-httproute-goldilocks") (get $checkReady "goldilocks") }}
---
apiVersion: protection.crossplane.io/v1beta1
kind: Usage
metadata:
  name: {{ $state.name }}-delete-goldilocks-route-before-goldilocks
  annotations:
    {{ setResourceNameAnnotation "usage-goldilocks-route-goldilocks" }}
  labels: {{ $state.labels | toJson }}
spec:
  replayDeletion: true
  of:
    apiVersion: helm.m.crossplane.io/v1beta1
    kind: Release
    resourceRef:
      name: {{ $state.goldilocks.name }}
  by:
    apiVersion: kubernetes.m.crossplane.io/v1alpha1
    kind: Object
    resourceRef:
      name: {{ $state.name }}-exposure-httproute-goldilocks
{{- end }}
{{- end }}
