# code: language=yaml
#
# Helm Release: kube-prometheus-stack
#
# Chart defaults plus cross-component defaults:
# - Grafana datasources wired to Loki and Tempo components.
#

{{- $kps := $state.kubePrometheusStack }}
{{- $loki := $state.loki }}
{{- $tempo := $state.tempo }}

---
apiVersion: helm.m.crossplane.io/v1beta1
kind: Release
metadata:
  name: {{ $kps.name }}
  annotations:
    {{ setResourceNameAnnotation "kube-prometheus-stack" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  forProvider:
    chart:
      name: kube-prometheus-stack
      repository: https://prometheus-community.github.io/helm-charts
      # renovate: datasource=helm depName=kube-prometheus-stack registryUrl=https://prometheus-community.github.io/helm-charts
      version: 82.18.0
    namespace: {{ $kps.namespace }}
    {{- if $kps.overrideAllValues }}
    values:
      {{- toYaml $kps.overrideAllValues | nindent 6 }}
    {{- else }}
    {{- /* Build VPA custom resource state metrics */}}
    {{- $containerPath := list "status" "recommendation" "containerRecommendations" }}
    {{- $containerLabel := dict "container" (list "containerName") }}
    {{- $vpaMetrics := list
      (dict "name" "vpa_containerrecommendations_target" "help" "VPA target recommendation for a container resource." "each" (dict "type" "Gauge" "gauge" (dict "path" $containerPath "valueFrom" (list "target" "cpu") "labelsFromPath" $containerLabel "labelFromKey" "")) "commonLabels" (dict "resource" "cpu" "unit" "core"))
      (dict "name" "vpa_containerrecommendations_target" "help" "VPA target recommendation for a container resource." "each" (dict "type" "Gauge" "gauge" (dict "path" $containerPath "valueFrom" (list "target" "memory") "labelsFromPath" $containerLabel)) "commonLabels" (dict "resource" "memory" "unit" "byte"))
      (dict "name" "vpa_containerrecommendations_lowerbound" "help" "VPA lower bound recommendation for a container resource." "each" (dict "type" "Gauge" "gauge" (dict "path" $containerPath "valueFrom" (list "lowerBound" "cpu") "labelsFromPath" $containerLabel)) "commonLabels" (dict "resource" "cpu" "unit" "core"))
      (dict "name" "vpa_containerrecommendations_lowerbound" "help" "VPA lower bound recommendation for a container resource." "each" (dict "type" "Gauge" "gauge" (dict "path" $containerPath "valueFrom" (list "lowerBound" "memory") "labelsFromPath" $containerLabel)) "commonLabels" (dict "resource" "memory" "unit" "byte"))
      (dict "name" "vpa_containerrecommendations_upperbound" "help" "VPA upper bound recommendation for a container resource." "each" (dict "type" "Gauge" "gauge" (dict "path" $containerPath "valueFrom" (list "upperBound" "cpu") "labelsFromPath" $containerLabel)) "commonLabels" (dict "resource" "cpu" "unit" "core"))
      (dict "name" "vpa_containerrecommendations_upperbound" "help" "VPA upper bound recommendation for a container resource." "each" (dict "type" "Gauge" "gauge" (dict "path" $containerPath "valueFrom" (list "upperBound" "memory") "labelsFromPath" $containerLabel)) "commonLabels" (dict "resource" "memory" "unit" "byte"))
      (dict "name" "vpa_containerrecommendations_uncappedtarget" "help" "VPA uncapped target recommendation for a container resource." "each" (dict "type" "Gauge" "gauge" (dict "path" $containerPath "valueFrom" (list "uncappedTarget" "cpu") "labelsFromPath" $containerLabel)) "commonLabels" (dict "resource" "cpu" "unit" "core"))
      (dict "name" "vpa_containerrecommendations_uncappedtarget" "help" "VPA uncapped target recommendation for a container resource." "each" (dict "type" "Gauge" "gauge" (dict "path" $containerPath "valueFrom" (list "uncappedTarget" "memory") "labelsFromPath" $containerLabel)) "commonLabels" (dict "resource" "memory" "unit" "byte"))
    }}
    {{- /* Resource defaults. Stateful expensive-restart workloads get Guaranteed QoS
         (request == limit). Stateless restart-cheap ones get Burstable so they can
         soak unused node capacity. See references/karpenter-resource-best-practices §7.1. */}}
    {{- $promResources := dict
      "requests" (dict "cpu" "500m" "memory" "4Gi")
      "limits" (dict "memory" "4Gi")
    }}
    {{- $alertmanagerResources := dict
      "requests" (dict "cpu" "50m" "memory" "256Mi")
      "limits" (dict "memory" "256Mi")
    }}
    {{- $grafanaResources := dict
      "requests" (dict "cpu" "50m" "memory" "128Mi")
      "limits" (dict "cpu" "200m" "memory" "512Mi")
    }}
    {{- $operatorResources := dict
      "requests" (dict "cpu" "50m" "memory" "64Mi")
      "limits" (dict "cpu" "100m" "memory" "256Mi")
    }}
    {{- /* KSM caches state for every CRD's CRs. Crossplane-heavy clusters
         can have 800+ CRDs, requiring much more memory than a vanilla
         cluster. Guaranteed memory so it isn't evicted under pressure. */}}
    {{- $ksmResources := dict
      "requests" (dict "cpu" "100m" "memory" "1Gi")
      "limits" (dict "memory" "1Gi")
    }}
    {{- /* NodePool scheduling for non-daemonset components */}}
    {{- /* Alloy is the default collector and remote-writes into this Prometheus.
         Select only explicitly opted-in monitors here to avoid scraping every
         target twice and producing out-of-order samples. */}}
    {{- $directScrapeSelector := dict
      "matchLabels" (dict "hops.ops.com.ai/scrape-directly" "prometheus")
    }}
    {{- $promSpec := dict
      "enableRemoteWriteReceiver" true
      "retention" (printf "%vd" $state.aws.prometheus.retentionDays)
      "retentionSize" $state.aws.prometheus.retentionSize
      "serviceMonitorSelectorNilUsesHelmValues" false
      "serviceMonitorSelector" $directScrapeSelector
      "podMonitorSelectorNilUsesHelmValues" false
      "podMonitorSelector" $directScrapeSelector
      "ruleSelectorNilUsesHelmValues" false
      "resources" $promResources
      "storageSpec" (dict
        "volumeClaimTemplate" (dict
          "spec" (dict
            "storageClassName" $state.aws.prometheus.pvc.storageClass.name
            "resources" (dict "requests" (dict "storage" $state.aws.prometheus.pvc.size))
          )
        )
      )
    }}
    {{- $alertmanagerSpec := dict "resources" $alertmanagerResources }}
    {{- $grafanaValues := dict
      "enabled" true
      "replicas" 1
      "resources" $grafanaResources
    }}
    {{- $grafanaDb := $state.grafana.database }}
    {{- $grafanaDbConfigured := and $grafanaDb.enabled (or $state.observed.grafanaPsql.ready $state.observed.grafanaPsql.activated) }}
    {{- $operatorValues := dict "enabled" true "resources" $operatorResources }}
    {{- $ksmValues := dict "resources" $ksmResources }}
    {{- $nodeExporterValues := dict "enabled" false }}
    {{- if $state.ha.prometheus.enabled }}
      {{- $_ := set $promSpec "replicas" $state.ha.prometheus.replicas }}
      {{- $_ := set $promSpec "topologySpreadConstraints" (list (dict
        "maxSkew" 1
        "topologyKey" "topology.kubernetes.io/zone"
        "whenUnsatisfiable" "ScheduleAnyway"
        "labelSelector" (dict "matchLabels" (dict "app.kubernetes.io/name" "prometheus"))
      )) }}
    {{- end }}
    {{- if $state.ha.alertmanager.enabled }}
      {{- $_ := set $alertmanagerSpec "replicas" $state.ha.alertmanager.replicas }}
      {{- $_ := set $alertmanagerSpec "topologySpreadConstraints" (list (dict
        "maxSkew" 1
        "topologyKey" "topology.kubernetes.io/zone"
        "whenUnsatisfiable" "ScheduleAnyway"
        "labelSelector" (dict "matchLabels" (dict "app.kubernetes.io/name" "alertmanager"))
      )) }}
    {{- end }}
    {{- if and $state.ha.grafana.enabled $grafanaDbConfigured }}
      {{- $_ := set $grafanaValues "replicas" $state.ha.grafana.replicas }}
    {{- end }}
    {{- if $state.nodePool.enabled }}
      {{- $_ := set $promSpec "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $promSpec "tolerations" $state.nodePool.tolerations }}
      {{- $_ := set $alertmanagerSpec "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $alertmanagerSpec "tolerations" $state.nodePool.tolerations }}
      {{- $_ := set $grafanaValues "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $grafanaValues "tolerations" $state.nodePool.tolerations }}
      {{- $_ := set $operatorValues "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $operatorValues "tolerations" $state.nodePool.tolerations }}
      {{- $_ := set $ksmValues "nodeSelector" $state.nodePool.nodeSelector }}
      {{- $_ := set $ksmValues "tolerations" $state.nodePool.tolerations }}
    {{- end }}
    {{- /* Build grafana values with optional nodeSelector/tolerations */}}
    {{- $grafanaBase := dict
      "sidecar" (dict
        "datasources" (dict
          "enabled" false
          "defaultDatasourceEnabled" false
          "alertmanager" (dict "enabled" false)
        )
      )
      "additionalDataSources" (list
        (dict "name" "Loki" "type" "loki" "uid" "loki" "access" "proxy"
          "url" (printf "http://%s-gateway.%s:80" $loki.name $loki.namespace)
          "jsonData" (dict
            "maxLines" 1000
            "derivedFields" (list (dict
              "name" "TraceID"
              "matcherRegex" "\"traceId\":\"([a-f0-9]+)\""
              "url" "$${__value.raw}"
              "datasourceUid" "tempo"
            ))
          )
        )
        (dict "name" "Tempo" "type" "tempo" "uid" "tempo" "access" "proxy"
          "url" (printf "http://%s.%s:3200" $tempo.name $tempo.namespace)
          "jsonData" (dict
            "httpMethod" "GET"
            "tracesToLogsV2" (dict "datasourceUid" "loki" "spanStartTimeShift" "-1h" "spanEndTimeShift" "1h" "filterByTraceID" true "filterBySpanID" false)
            "tracesToMetrics" (dict "datasourceUid" "prometheus" "spanStartTimeShift" "-1h" "spanEndTimeShift" "1h")
            "serviceMap" (dict "datasourceUid" "prometheus")
            "nodeGraph" (dict "enabled" true)
            "lokiSearch" (dict "datasourceUid" "loki")
          )
        )
      )
    }}
    {{- $_ := set $alertmanagerSpec "fullnameOverride" "alertmanager" }}
    {{- $_ := set $promSpec "fullnameOverride" "prometheus" }}
    {{- $_ := set $grafanaBase "fullnameOverride" "grafana" }}
    {{- $_ := set $operatorValues "fullnameOverride" "prometheus-operator" }}
    {{- $_ := set $nodeExporterValues "fullnameOverride" "node-exporter" }}

    {{- $grafanaIni := dict }}
    {{- $grafanaExtraSecretMounts := list }}
    {{- if $grafanaDbConfigured }}
      {{- $_ := set $grafanaIni "database" (dict
        "type" "postgres"
        "host" (printf "%s:%v" $grafanaDb.embedded.host $grafanaDb.embedded.port)
        "name" $grafanaDb.embedded.app.database
        "user" (printf "$__file{%s/username}" $grafanaDb.mountPath)
        "password" (printf "$__file{%s/password}" $grafanaDb.mountPath)
        "ssl_mode" $grafanaDb.sslMode
      ) }}
      {{- $_ := set $grafanaIni "security" (dict
        "secret_key" (printf "$__file{%s/password}" $grafanaDb.mountPath)
      ) }}
      {{- $grafanaExtraSecretMounts = append $grafanaExtraSecretMounts (dict
        "name" "grafana-db"
        "secretName" $grafanaDb.embedded.app.secretName
        "mountPath" $grafanaDb.mountPath
        "readOnly" true
      ) }}
    {{- end }}

    {{- /* Grafana app-level OIDC (per tasks/observe-stack-grafana-oidc).
           When spec.exposure.grafana.enabled, layer Helm values for
           generic_oauth + session knobs onto $grafanaBase. The Zitadel
           OIDC App composed in 420-* writes client_id + client_secret
           to <observe-ns>-grafana-oidc-client; we mount that Secret
           via extraSecretMounts and reference values via $__file{}
           so the secret never lives in pod env. */}}
    {{- $g := $state.exposure.grafana }}
    {{- if and $g.enabled (ne $g.host "") }}
      {{- $grafanaOidcSecret := printf "%s-grafana-oidc-client" $state.namespace }}
      {{- $grafanaOidcMountPath := "/etc/secrets/grafana-oidc" }}
      {{- $generic := dict
        "enabled" true
        "name" "Zitadel"
        "allow_sign_up" true
        "auto_login" $g.autoLogin
        "client_id" (printf "$__file{%s/attribute.client_id}" $grafanaOidcMountPath)
        "client_secret" (printf "$__file{%s/attribute.client_secret}" $grafanaOidcMountPath)
        "scopes" "openid email profile"
        "auth_url" (printf "%s/oauth/v2/authorize" $state.auth.issuerURL)
        "token_url" (printf "%s/oauth/v2/token" $state.auth.issuerURL)
        "api_url" (printf "%s/oidc/v1/userinfo" $state.auth.issuerURL)
        "use_refresh_token" $g.useRefreshToken
        "login_attribute_path" "preferred_username"
        "email_attribute_path" "email"
        "name_attribute_path" "name"
      }}
      {{- if gt (len $g.allowedDomains) 0 }}
        {{- $_ := set $generic "allowed_domains" (join "," $g.allowedDomains) }}
      {{- end }}
      {{- if ne $g.roleAttributePath "" }}
        {{- $_ := set $generic "role_attribute_path" $g.roleAttributePath }}
        {{- $_ := set $generic "role_attribute_strict" true }}
      {{- end }}
      {{- if $g.allowAssignGrafanaAdmin }}
        {{- $_ := set $generic "allow_assign_grafana_admin" true }}
      {{- end }}
      {{- if ne $g.orgAttributePath "" }}
        {{- $_ := set $generic "org_attribute_path" $g.orgAttributePath }}
      {{- end }}
      {{- if gt (len $g.orgMapping) 0 }}
        {{- $_ := set $generic "org_mapping" (join "," $g.orgMapping) }}
      {{- end }}
      {{- $_ := set $grafanaIni "server" (dict
        "domain" $g.host
        "root_url" (printf "https://%s" $g.host)
      ) }}
      {{- $_ := set $grafanaIni "auth.generic_oauth" $generic }}
      {{- $_ := set $grafanaIni "auth" (dict
        "login_maximum_lifetime_duration" $g.maxSessionDuration
        "token_rotation_interval_minutes" $g.tokenRotationMinutes
        "oauth_auto_login" $g.autoLogin
      ) }}
      {{- $grafanaExtraSecretMounts = append $grafanaExtraSecretMounts (dict
        "name" "grafana-oidc"
        "secretName" $grafanaOidcSecret
        "mountPath" $grafanaOidcMountPath
        "readOnly" true
      ) }}
    {{- end }}
    {{- if $grafanaIni }}
      {{- $_ := set $grafanaBase "grafana.ini" $grafanaIni }}
    {{- end }}
    {{- if gt (len $grafanaExtraSecretMounts) 0 }}
      {{- $_ := set $grafanaBase "extraSecretMounts" $grafanaExtraSecretMounts }}
    {{- end }}

    {{- $grafana := merge $grafanaValues $grafanaBase }}
    {{- /* Build kube-state-metrics values with optional nodeSelector/tolerations */}}
    {{- $ksmBase := dict
      "rbac" (dict
        "extraRules" (list (dict
          "apiGroups" (list "autoscaling.k8s.io")
          "resources" (list "verticalpodautoscalers")
          "verbs" (list "list" "watch")
        ))
      )
      "customResourceState" (dict
        "enabled" true
        "config" (dict
          "spec" (dict
            "resources" (list (dict
              "groupVersionKind" (dict "group" "autoscaling.k8s.io" "version" "v1" "kind" "VerticalPodAutoscaler")
              "labelsFromPath" (dict
                "namespace" (list "metadata" "namespace")
                "verticalpodautoscaler" (list "metadata" "name")
                "target_kind" (list "spec" "targetRef" "kind")
                "target_name" (list "spec" "targetRef" "name")
                "target_api_version" (list "spec" "targetRef" "apiVersion")
              )
              "metrics" $vpaMetrics
            ))
          )
        )
      )
    }}
    {{- $_ := set $ksmBase "fullnameOverride" "kube-state-metrics" }}
    {{- $ksm := merge $ksmValues $ksmBase }}
    {{- $defaults := dict
      "cleanPrometheusOperatorObjectNames" true
      "fullnameOverride" "observe"
      "prometheusOperator" $operatorValues
      "prometheus" (dict
        "enabled" true
        "prometheusSpec" $promSpec
      )
      "alertmanager" (dict "enabled" true "alertmanagerSpec" $alertmanagerSpec)
      "grafana" $grafana
      "kube-state-metrics" $ksm
      "nodeExporter" $nodeExporterValues
    }}
    {{- $merged := mustMergeOverwrite $defaults ($kps.values | default dict) }}
    values:
      {{- toYaml $merged | nindent 6 }}
    {{- end }}
  rollbackLimit: 3
  providerConfigRef:
    name: {{ $state.helm.providerConfigRef.name }}
    kind: {{ $state.helm.providerConfigRef.kind }}

{{- if and $state.observed.grafanaOperator.ready $state.observed.kubePrometheusStack.ready }}
---
apiVersion: protection.crossplane.io/v1beta1
kind: Usage
metadata:
  name: {{ $state.name }}-delete-grafana-operator-before-kube-prometheus-stack
  annotations:
    {{ setResourceNameAnnotation "usage-kps-grafop" }}
  labels: {{ $state.labels | toJson }}
spec:
  replayDeletion: true
  of:
    apiVersion: helm.m.crossplane.io/v1beta1
    kind: Release
    resourceRef:
      name: {{ $kps.name }}
  by:
    apiVersion: helm.m.crossplane.io/v1beta1
    kind: Release
    resourceRef:
      name: {{ $state.grafanaOperator.name }}
{{- end }}
